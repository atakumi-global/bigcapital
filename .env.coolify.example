# Coolify deployment variables for docker-compose.coolify.yml.
#
# Coolify auto-generates all SERVICE_* secrets (DB passwords, Redis password,
# JWT secret) and SERVICE_URL_WEBAPP / SERVICE_FQDN_WEBAPP_80 once you assign
# a domain to the `webapp` service. Do NOT set those yourself.
#
# Everything below is optional and editable in the Coolify UI
# (Environment Variables tab of the compose resource).

# --- Mail (SMTP) -------------------------------------------------------
# Needed for user invites, password resets and emailed invoices.
# Without these the app still boots, those features just fail on send.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Bigcapital
MAIL_FROM_ADDRESS=

# --- Database / tenant naming ------------------------------------------
# Defaults match the scoped GRANTs created by the mysql container init.
# If you change TENANT_DB_NAME_PERFIX later, existing GRANTs no longer
# match new tenant databases — keep it stable after first deploy.
DB_USER=bigcapital
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# --- Sign-up policy -----------------------------------------------------
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# --- S3 document attachments -------------------------------------------
# Attachments upload through multer-s3 with no local-disk fallback, so set
# these if you use the Attachments feature. Any S3-compatible endpoint works.
S3_REGION=US
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# --- Bank feeds ----------------------------------------------------------
BANK_FEED_ENABLED=false
# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Must be https://<your-domain>/api/... once deployed.
PLAID_LINK_WEBHOOK=
# Wise
WISE_API_TOKEN=
WISE_API_BASE_URL=https://api.wise.com
WISE_PROFILE_ID=
WISE_WEBHOOK_SECRET=

# --- Exchange rates ------------------------------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# --- Analytics -----------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Stripe payments -----------------------------------------------------
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
# https://<your-domain>/preferences/payment-methods/stripe/callback
STRIPE_PAYMENT_REDIRECT_URL=
